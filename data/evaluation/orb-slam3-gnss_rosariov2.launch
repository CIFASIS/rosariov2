<?xml version="1.0" encoding="UTF-8"?> 
<launch> 

    <arg name="vocabulary" default="$(find GNSS_SI)/../../../Vocabulary/ORBvoc.txt" doc="Vocabulary for DBoW2."/> 
    <arg name="settings" default="$(find GNSS_SI)/../../Stereo-Inertial/rosariov2/orb-slam3-gnss_rosariov2.yaml" doc="System settings."/> 
    
    <arg name="map_frame_id" default="map"/>
    <arg name="base_link_frame_id" default="base_link"/>
    <arg name="do_rectify" default="false" />

    <node name="orbslam3_gnss_stereo_inertial" pkg="GNSS_SI" type="GNSS_Stereo_Inertial" output="log" args="$(arg vocabulary) $(arg settings) $(arg do_rectify)"> 
        <remap from="/camera/left/image_raw" to="/realsense/infra1/image_rect_raw"/>
        <remap from="/camera/right/image_raw" to="/realsense/infra2/image_rect_raw"/>           
        <remap from="/imu" to="/realsense/imu"/>
        <remap from='/gps/fix/' to="reach_1/gps/fix"/>
        <param name="map_frame_id" value="$(arg map_frame_id)"/>
        <param name="base_link_frame_id" value="$(arg base_link_frame_id)"/>
    </node>

    <node pkg="tf2_ros" type="static_transform_publisher" name="start_broadcaster" args="0 0 0 0 0 0 start map"/>
</launch>
